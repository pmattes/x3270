# Makefile for tcl3270-pkg.

top = ../../..
objdir = ../obj/@host@/tcl3270-pkg
this = $(top)/tcl3270-pkg

export TOP = $(top)
export THIS = $(this)

default: all
all install clean clobber: $(objdir)
	$(MAKE) -C $(objdir) -f $(this)/Makefile.obj $@

$(objdir):
	mkdir -p $(objdir)
